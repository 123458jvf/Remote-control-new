name: Build Android APKs

on:
  push:
    branches: [ "main" ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout Code
      uses: actions/checkout@v4

    - name: Set up JDK 17
      uses: actions/setup-java@v4
      with:
        java-version: '17'
        distribution: 'temurin'

    - name: Setup Android SDK
      uses: android-actions/setup-android@v3

    - name: Grant Execute Permission to Gradlew
      run: chmod +x gradlew

    - name: Build Host and Controller APKs
      run: ./gradlew assembleDebug

    - name: Upload Jahid Host APK
      uses: actions/upload-artifact@v4
      with:
        name: Jahid-Host-App-debug
        path: app-host/build/outputs/apk/debug/app-host-debug.apk

    - name: Upload Shikha Controller APK
      uses: actions/upload-artifact@v4
      with:
        name: Shikha-Controller-App-debug
        path: app-controller/build/outputs/apk/debug/app-controller-debug.apk
